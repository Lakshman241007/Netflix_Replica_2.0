{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin-app/(.*)",
      "destination": "/admin-app/$1"
    },
    {
      "source": "/((?!api|admin-app).*)",
      "destination": "/index.html"
    }
  ]
}
